<%- include('./layouts/header') %>
    
    <div class="min-vh-100 d-flex align-items-center justify-content-center bg-light">
  <div class="card shadow-lg p-4" style="max-width: 480px; width: 100%; border-radius: 16px;">
    <div class="text-center mb-4">
      <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px; font-size: 24px; font-weight: bold;">
        U
      </div>
      <h2 class="mt-3 fw-bold text-dark">Create Your Account</h2>
      <p class="text-muted">Join our community in seconds</p>
    </div>

    <form action="/register" method="post" enctype="multipart/form-data">
      <!-- Username -->
      <div class="mb-3">
        <label for="username" class="form-label fw-semibold">Username</label>
        <input 
          type="text" 
          class="form-control py-2" 
          id="username" 
          name="username" 
          placeholder="e.g. john_doe" 
          required
        >
      </div>

      <!-- Email -->
      <div class="mb-3">
        <label for="email" class="form-label fw-semibold">Email</label>
        <input 
          type="email" 
          class="form-control py-2" 
          id="email" 
          name="email" 
          placeholder="name@example.com" 
          required
        >
      </div>

      <!-- Password -->
      <div class="mb-3">
        <label for="password" class="form-label fw-semibold">Password</label>
        <input 
          type="password" 
          class="form-control py-2" 
          id="password" 
          name="password" 
          placeholder="••••••••" 
          required
        >
      </div>

      <!-- Profile Picture -->
      <div class="mb-4">
        <label for="profilePic" class="form-label fw-semibold">Profile Picture <span class="text-muted">(Optional)</span></label>
        <input 
          class="form-control py-1" 
          type="file" 
          id="profilePic" 
          name="profilePic" 
          accept="image/*"
        >
        <div class="form-text text-muted small">JPG, PNG or GIF — max 2MB</div>
      </div>

      <!-- Submit Button -->
      <div class="d-grid">
        <button type="submit" class="btn btn-primary py-2 fw-bold rounded-3">Register Now</button>
      </div>
    </form>

    <!-- Login Link -->
    <div class="text-center mt-4 pt-3 border-top">
      <p class="mb-0 text-muted">
        Already have an account? 
        <a href="/" class="text-primary text-decoration-none fw-bold">Sign in</a>
      </p>
    </div>
  </div>
</div>


<%- include('./layouts/footer') %>